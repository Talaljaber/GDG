# Copy to .env.local and fill in real values. Never commit real values.

# Supabase project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Never the secret key (ADR-125).
VITE_SUPABASE_PUBLISHABLE_KEY=

# The short URL shown under the QR on the big screen (DEPLOYMENT.md §3)
VITE_PUBLIC_SHORT_URL=

# Set by the build to the commit SHA (DEPLOYMENT.md §3)
VITE_APP_VERSION=

# LOCAL stack only: the admin that `npm run dev:admin` creates and the e2e tests sign in with.
# Not VITE_-prefixed, so never bundled. Never put a real (dev/prod) admin password here.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
